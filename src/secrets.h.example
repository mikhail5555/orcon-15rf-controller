// secrets.h — your local Wi-Fi / MQTT settings.
// Copy this file to src/secrets.h (git-ignored) and fill in your values.
// Anything defined here overrides the defaults in config.h; delete the lines
// you don't need. The web UI / SoftAP portal can still change Wi-Fi and the
// MQTT host at runtime.
#pragma once

// Wi-Fi. Empty SSID => boot into the SoftAP setup portal.
#define WIFI_SSID        "your-ssid"
#define WIFI_PASSWORD    "your-wifi-password"

// SoftAP setup portal.
#define WIFI_AP_NAME     "Orcon15RF-Setup"
#define WIFI_AP_PASS     "change-me-8+chars"   // >= 8 chars

// MQTT.
#define MQTT_ENABLED     1                     // 0 => no MQTT client at all
#define MQTT_HOST        "192.168.1.10"
#define MQTT_PORT        1883
#define MQTT_USER        "your-mqtt-user"      // "" => connect without auth
#define MQTT_PASS        "your-mqtt-password"
#define MQTT_BASE_TOPIC  "orcon15rf"           // orcon15rf/state, orcon15rf/cmd, ...
